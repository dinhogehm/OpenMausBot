FROM node:24.20.0-trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 python3-venv python3-pip ca-certificates build-essential util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.33.0 \
    && mkdir -p /tmp/veltram-home
# The outbound interception CA is supplied at runtime, never baked into the image.
ENTRYPOINT ["sh", "-c", "if [ -f /etc/cloudflare/certs/cloudflare-containers-ca.crt ]; then cp /etc/cloudflare/certs/cloudflare-containers-ca.crt /usr/local/share/ca-certificates/veltram-containers.crt && update-ca-certificates >/dev/null; fi; exec sleep infinity"]
