{
  "name": "@openmausbot/cloud-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "pnpm test:unit && vitest run",
    "test:unit": "node --experimental-strip-types --test test/execution.test.ts test/credentials.test.ts test/linux-proof.test.ts test/coding-program.test.ts web/test/run-state.test.ts web/test/api.test.ts web/test/coding-state.test.ts",
    "test:integration": "vitest run",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json",
    "dry-run": "pnpm build && wrangler deploy --dry-run",
    "build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "better-auth": "1.7.8",
    "zod": "4.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.151.0",
    "vite": "7.3.6",
    "@vitejs/plugin-react": "4.7.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
