{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veltram-isolated-fixture",
  "main": "browser-worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "../../dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8795",
    "EMAIL_FROM": "noreply@example.invalid",
    "AUTH_SECRET": "fixture-only-auth-secret-at-least-32-characters",
    "CREDENTIAL_MASTER_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "durable_objects": { "bindings": [
    { "name": "RUNS", "class_name": "ExecutionRoom" },
    { "name": "ADMISSION", "class_name": "Admission" },
    { "name": "LINUX_EXECUTORS", "class_name": "LinuxExecutor" },
    { "name": "CODING_RUNS", "class_name": "CodingRoom" },
    { "name": "CODING_ADMISSION", "class_name": "CodingAdmission" },
    { "name": "CODING_EXECUTORS", "class_name": "CodingExecutor" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ExecutionRoom", "Admission", "LinuxExecutor"] },
    { "tag": "v2", "new_sqlite_classes": ["CodingRoom", "CodingAdmission", "CodingExecutor"] }
  ],
  "containers": [
    { "class_name": "LinuxExecutor", "scheduling_policy": "durable_object" },
    { "class_name": "CodingExecutor", "scheduling_policy": "durable_object", "images": { "coding": { "dockerfile": "../../Dockerfile.coding", "build_context": "../.." } } }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "veltram-fixture", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }]
}
