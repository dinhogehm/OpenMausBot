{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veltram",
  "account_id": "768841fa976bce74242ce11c4e98bc9d",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "veltram.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist", "binding": "ASSETS", "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "durable_objects": { "bindings": [
    { "name": "RUNS", "class_name": "ExecutionRoom" },
    { "name": "ADMISSION", "class_name": "Admission" },
    { "name": "LINUX_EXECUTORS", "class_name": "LinuxExecutor" },
    { "name": "CODING_RUNS", "class_name": "CodingRoom" },
    { "name": "CODING_ADMISSION", "class_name": "CodingAdmission" },
    { "name": "CODING_EXECUTORS", "class_name": "CodingExecutor" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ExecutionRoom", "Admission", "LinuxExecutor"] },
    { "tag": "v2", "new_sqlite_classes": ["CodingRoom", "CodingAdmission", "CodingExecutor"] }
  ],
  "containers": [
    { "class_name": "LinuxExecutor", "scheduling_policy": "durable_object" },
    { "class_name": "CodingExecutor", "scheduling_policy": "durable_object", "images": { "coding": { "dockerfile": "./Dockerfile.coding", "build_context": "." } } }
  ],
  "vars": {
    "APP_ORIGIN": "https://veltram.com",
    "EMAIL_FROM": "noreply@veltram.com",
    "RELEASE_ID": "veltram-2026-10-14.3"
  },
  "secrets": { "required": ["AUTH_SECRET", "CREDENTIAL_MASTER_KEY"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "veltram",
    "database_id": "8d86866b-bf87-4c2f-afcc-f8324fbea0ae",
    "migrations_dir": "migrations"
  }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@veltram.com"] }]
}
